#!/usr/bin/env python3
"""{{NAME}} — generated by TERMy ({{LANG}})."""


def fibonacci(n: int) -> None:
    """Print the first n terms of the Fibonacci sequence."""
    a, b = 0, 1
    terms = []
    for _ in range(n):
        terms.append(a)
        a, b = b, a + b
    print(f"First {n} terms of the Fibonacci sequence:")
    print(" ".join(map(str, terms)))


if __name__ == "__main__":
    fibonacci({{N}})