#!/usr/bin/env python3
"""{{NAME}} — generated by TERMy ({{LANG}})."""


def is_prime(n: int) -> None:
    """Trial division up to sqrt(n)."""
    if n < 2:
        print(f"{n} is NOT prime (less than 2)")
        return
    i = 2
    while i * i <= n:
        if n % i == 0:
            print(f"{n} is NOT prime (divisible by {i})")
            return
        i += 1
    print(f"{n} is PRIME")


if __name__ == "__main__":
    is_prime({{N}})