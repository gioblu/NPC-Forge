#!/usr/bin/env python3
"""{{NAME}} — generated by TERMy ({{LANG}}).

Assumes the input list is already sorted.
"""


def binary_search(target: int, data: list[int]) -> None:
    """Halve the search space each step — O(log n)."""
    low, high = 0, len(data) - 1
    while low <= high:
        mid = (low + high) // 2
        if data[mid] == target:
            print(f"Found {target} at index {mid}")
            return
        if data[mid] < target:
            low = mid + 1
        else:
            high = mid - 1
    print(f"{target} not found")


if __name__ == "__main__":
    binary_search({{TARGET}}, [{{ARRAY}}])