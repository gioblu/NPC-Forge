#!/usr/bin/env node
// {{NAME}} — generated by TERMy ({{LANG}})
"use strict";

/** Return n!; throws on negative input. */
function factorial(n) {
  if (n < 0) throw new Error("factorial is undefined for negative numbers");
  let result = 1;
  for (let i = 2; i <= n; i++) result *= i;
  return result;
}

const n = {{N}};
console.log(`${n}! = ${factorial(n)}`);