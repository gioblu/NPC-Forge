#!/usr/bin/env python3
"""{{NAME}} — generated by TERMy ({{LANG}}).

{{ARRAY}} is injected comma-separated, so [{{ARRAY}}] is a valid list.
"""


def linear_search(target: int, data: list[int]) -> None:
    """Scan left to right — O(n)."""
    for i, value in enumerate(data):
        if value == target:
            print(f"Found {target} at index {i}")
            return
    print(f"{target} not found in {data}")


if __name__ == "__main__":
    linear_search({{TARGET}}, [{{ARRAY}}])