#!/usr/bin/env python3
"""{{NAME}} — generated by TERMy ({{LANG}})."""


def bubble_sort(data: list[int]) -> None:
    """Repeatedly swap adjacent out-of-order pairs — O(n^2)."""
    arr = list(data)
    print(f"Before: {arr}")
    n = len(arr)
    for i in range(n):
        for j in range(n - i - 1):
            if arr[j] > arr[j + 1]:
                arr[j], arr[j + 1] = arr[j + 1], arr[j]
    print(f"After:  {arr}")


if __name__ == "__main__":
    bubble_sort([{{ARRAY}}])