// {{NAME}} — generated by TERMy ({{LANG}})
// {{ARRAY_LEN}} sizes the array; {{ARRAY}} is comma-separated.

/// Scan left to right — O(n). Returns the first matching index.
fn linear_search(target: i64, data: &[i64]) -> Option<usize> {
    data.iter().position(|&value| value == target)
}

fn main() {
    let target: i64 = {{TARGET}};
    let data: [i64; {{ARRAY_LEN}}] = [{{ARRAY}}];

    match linear_search(target, &data) {
        Some(i) => println!("Found {} at index {}", target, i),
        None => println!("{} not found", target),
    }
}