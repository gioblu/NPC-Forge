#!/usr/bin/env python3
from __future__ import annotations

import argparse
import json
import os
import sys
from pathlib import Path

from rich.console import Console
from tui.tools import TuiTools
from storage.dataset import DatasetStorage

CURRENT_BOT_DIR = Path(os.path.realpath(__file__)).parent
FORGE_ROOT_DIR = str(CURRENT_BOT_DIR.parent.parent)
sys.path.append(str(Path(FORGE_ROOT_DIR) / "src"))

from interpreters.base import ExecutionContext, ExecutionResult
from interpreters.deterministic import DeterministicInterpreter
from interpreters.probabilistic import ProbabilisticInterpreter
from interpreters.hybrid import HybridInterpreter
from decomposers import DeterministicDecomposer, ProbabilisticDecomposer

tui = TuiTools()
storage = DatasetStorage()
console = Console()

def run_cli() -> int:
    home_dir = os.path.expanduser("~")
    config_path = os.path.join(home_dir, ".local/share/termy/")
    
    config = storage.load_json(CURRENT_BOT_DIR, "config.json") or {}
    context = storage.load_json(Path(config_path), "config.json") or {}
    
    if not isinstance(context.get("summary"), list): context["summary"] = []
    
    llm_config = config.get("llm", {})
    
    parser = argparse.ArgumentParser(
        description="TERMy - The world's first neuro-symbolic AI terminal assistant",
        usage='\n termy [OPTIONS] "hello"\n termy [OPTIONS] hello\n echo "hello" | termy [OPTIONS]\n termy -y < test.termy\n'
    )
    
    parser.add_argument("query", nargs="*", help="Prompt input string.")
    parser.add_argument("--npc", default="termy", help="Target NPC instance (default: termy)")
    parser.add_argument("-i", "--interpreter", choices=["d", "p", "h"], default="d", help="interpreter strategy: deterministic (d), probabilistic (p), or hybrid (d)")
    parser.add_argument("-d", "--decomposer", choices=["d", "p"], default="d", help="Decomposition strategy for hybrid interpreter: deterministic (d) or probabilistic (p)")
    parser.add_argument("-c", "--context", nargs="?", const=llm_config.get('num_ctx', 4096), default=0, type=int, help="Include system context with an optional response buffer size")
    parser.add_argument("-a", "--agent", action="store_true", help="Includes session context (for agentic workflows)")
    parser.add_argument("-r", "--remove-context", action="store_true", help="Clear all values from the session context")
    parser.add_argument("-y", "--yes", action="store_true", help="Automatically answer yes to prompts (skip confirmation)")
    parser.add_argument("-g", "--generate", action="store_true", help="Force request to probabilistic interpreter.")
    
    args = parser.parse_args()
    
    if args.remove_context:
        context_file = Path(config_path) / "config.json"
        context_file.parent.mkdir(parents=True, exist_ok=True)
        with open(context_file, "w", encoding="utf-8") as f:
            json.dump({}, f, indent=4, ensure_ascii=False)
        console.print("\n[green]Session context cleared successfully.[/green]\n")
        return 0

    if not sys.stdin.isatty(): user_input = sys.stdin.read().strip()
    elif args.query: user_input = " ".join(args.query).strip()
    else: parser.error("Provide input via arguments or pipe!\n")
    if not user_input: parser.error("The query must not be empty!\n")
    if args.yes: os.environ["TERMY_YES"] = "1"

    # Inject runtime flags into args for the interpreters to read
    args.context_path = os.path.join(config_path, "config.json")
    args.force_yes = os.environ.get("TERMY_YES") == "1" or args.yes
    
    args.llm_detail = ""
    if args.interpreter in ("p", "h") and llm_config.get("enabled", False) and not args.generate:
        args.llm_detail = tui.prompt(f"\nDescribe how TERMy should respond to [green]'{user_input}'[/green] (or press Enter to skip)")
        console.print()

    exec_ctx = ExecutionContext(
        console=console,
        tui=tui,
        config=config,
        cli_args=args,
        current_bot_dir=str(CURRENT_BOT_DIR),
        forge_root_dir=FORGE_ROOT_DIR,
        context_path=args.context_path
    )

    if args.interpreter == "d": interpreter = DeterministicInterpreter()
    elif args.interpreter == "p": interpreter = ProbabilisticInterpreter()
    else:  # hybrid
        decomposer = ProbabilisticDecomposer(config.get("llm", {})) if args.decomposer == "p" else DeterministicDecomposer()
        interpreter = HybridInterpreter(decomposer)

    result: ExecutionResult = interpreter.interpret(user_input, context, exec_ctx)

    Path(exec_ctx.context_path).parent.mkdir(parents=True, exist_ok=True)
    with open(exec_ctx.context_path, "w", encoding="utf-8") as f:
        json.dump(context, f, indent=4, ensure_ascii=False)

    return result.exit_code

if __name__ == "__main__":
    sys.exit(run_cli())