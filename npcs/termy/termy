#!/usr/bin/env python3
from __future__ import annotations

import argparse
import os
import sys
import shlex
import subprocess
from pathlib import Path

from providers.ollama import OllamaProvider
from providers.api import ApiProvider
from providers.local import LocalProvider
from tui.tools import TuiTools, BOLD, GREEN, RED, RESET, YELLOW
from storage.dataset import DatasetStorage

from rich.console import Console
from rich.markdown import Markdown

tui = TuiTools()
storage = DatasetStorage()

def run_cli() -> int:
    usage_text = (
        '\n termy [OPTIONS] "hello"\n '
        'termy [OPTIONS] hello\n echo "hello" | '
        'termy [OPTIONS]\n termy -y < test.termy\n'
    )
    
    parser = argparse.ArgumentParser(
        description="TERMy - The frontier of deterministic AI",
        usage=usage_text,
    )
    
    parser.add_argument("query", nargs="*", help="Prompt input string.")
    parser.add_argument("--npc", default="termy", help="Target NPC instance (default: termy)")
    parser.add_argument("-y", "--yes", action="store_true", help="Automatically answer yes to prompts (skip confirmation)")
    parser.add_argument("-v", "--verbose", action="store_true", help="Show debugging information")
    parser.add_argument("-g", "--generate", action="store_true", help="Send request to ollama.")
    
    args = parser.parse_args()

    if not sys.stdin.isatty(): user_input = sys.stdin.read().strip()
    elif args.query: user_input = " ".join(args.query).strip()
    else: parser.error("Provide input via arguments or pipe!\n")
    if not user_input: parser.error("The query must not be empty!\n")

    if args.yes: os.environ["TERMY_YES"] = "1"

    client = ApiProvider(url="http://127.0.0.1:5000", timeout=10.0)
    result = client.request(args.npc, user_input)
    
    console = Console() 
    
    if result is None:
        CURRENT_BOT_DIR = Path(os.path.realpath(__file__)).parent
        FORGE_ROOT_DIR = str(CURRENT_BOT_DIR.parent.parent)
        sys.stderr.write(
            f"NPC-Forge server is {RED}offline{RESET}, starting local...\n"
        )
        client = LocalProvider(FORGE_ROOT_DIR, CURRENT_BOT_DIR)
        result = client.request(args.npc, user_input)

    if result is None:
        sys.stderr.write(f"{RED}FATAL: Failed to process request locally.{RESET}\n")
        return 1

    emoji = result.get("emoji", "")
    response = result.get("response", "")
    permission = result.get("permission", "ask")
    thinking = result.get("thinking", "")    
    tools = result.get("tools", [])
    status = str(result.get("status", "rejected")).lower()
    confidence = result.get("confidence", 0.0)

    def permission_execute():
        return (
            permission == "yolo" or 
            permission == "auto" or 
            args.yes or 
            os.environ.get("TERMY_YES") == "1"
        )
    
    command = ""
    description = ""

    CURRENT_BOT_DIR = Path(os.path.realpath(__file__)).parent
    home_dir = os.path.expanduser("~")
    config_path = os.path.join(home_dir, ".local/share/termy/")
    config = storage.load_json(CURRENT_BOT_DIR, "config.json") or {}
    context = storage.load_json(Path(config_path), "config.json") or {}    
    
    related = result.get("related", [])
    llm_config = config.get("llm", {})
    llm_enabled = llm_config.get("enabled", False)
    llm_model = llm_config.get("model", "")
    
    conf_color = GREEN if confidence > 0.7 else (YELLOW if confidence > 0.5 else RED)
    meta = (
        f"\n{GREEN}{BOLD}{config.get('npc_name', '')}{RESET} | "
        f"{status} | "
        f"Confidence: {conf_color}{confidence * 100:.2f}%{RESET}\n"
    )
    
    if args.verbose: print(meta)
    else: print()

    if tools:
        for tool_group in tools:
            if not tool_group: 
                continue
            if isinstance(tool_group, dict):
                tool_group = [tool_group]
                
            for tool_data in tool_group:
                if not tool_data or not isinstance(tool_data, dict): 
                    continue
                tool_args = tool_data.get("arguments", {})
                
                if "command" in tool_args:
                    if command: 
                        command += " && "
                    command += tool_args["command"]
                
                if "explanation" in tool_args or "description" in result:
                    desc_part = tool_args.get(
                        "explanation", result.get("description", "")
                    ).strip()
                    if desc_part: description += " " + desc_part

    tts_engine = config.get("tts")
    if response and context.get("tts", "") == "on" and tts_engine:
        try:
            subprocess.run(
                f"pkill -9 -x {shlex.quote(tts_engine)}", 
                shell=True, 
                stdout=subprocess.DEVNULL, 
                stderr=subprocess.DEVNULL
            )
            subprocess.Popen(
                [tts_engine, response],
                stdout=subprocess.DEVNULL,
                stderr=subprocess.DEVNULL,
                start_new_session=True
            )
        except Exception as e:
            sys.stderr.write(f"Audio playback failed: {e}\n")

    if status != "rejected":
        tui.render_action(
            thinking=thinking,
            response=Markdown(response.strip()),
            command=command,
            description=description.strip(),
            emoji=emoji,
            title="TERMy"
        )
        print()
    elif status == "rejected" and (related or llm_enabled):
        choice = 0
        llm_selected = False
        
        related_menu = f"Choose related {GREEN}{BOLD}1-{len(related)}{RESET}\n" if related else ""
        
        related_intents = [
            intent["input"][0] if isinstance(intent["input"], list) else str(intent["input"]) 
            for intent in related
        ]
        
        if llm_enabled:
            menu_text = (
                f"{related_menu}Ask {llm_model} "
                f"{GREEN}{BOLD}a{RESET} Quit {GREEN}{BOLD}q{RESET}\n"
            )
        else:
            menu_text = (
                f"Type {GREEN}{BOLD}1-{len(related)}{RESET}"
                f"or {GREEN}{BOLD}q{RESET} to quit\n"
            )
            
        if (args.generate): choice = len(related) + 1
        else: choice = tui.multi_choice("Select an intent", related_intents, menu_text, 'g')
        
        if isinstance(choice, int) and 0 < choice <= len(related):
            try:
                script_path = os.path.abspath(sys.argv[0])
                res = subprocess.run([script_path, related_intents[choice - 1]], env=os.environ)
                return res.returncode
            except KeyboardInterrupt:
                print(f"\n\n{YELLOW}Execution cancelled.{RESET}\n")
                return 130
            except Exception as exc:
                print(f"\n\nFailed to execute recursive call: {exc}\n")
                return 1
   
        elif isinstance(choice, int) and choice == (len(related) + 1) and llm_enabled:
            llm_selected = True
        elif not choice or str(choice).lower() == 'q':
            return 0
                
        # Execute LLM generation if selected
        if (llm_enabled and llm_selected) or args.g:
            try:
                details = ""
                ollama_client = OllamaProvider(llm_config)
                if not args.generate:
                    details = tui.prompt(
                        f"\nDescribe how TERMy should respond to [green]'{user_input}'[/green]"
                    )
                    if not details: return 1                    
                console.print()
                with console.status(
                    f"[bold green]Generating script via {llm_model}...[/bold green]", 
                    spinner="dots"
                ): generated_intent = ollama_client.craft_intent(f"{user_input} {details}")
                
                if generated_intent:
                    try:
                        generated_intent["input"] = [user_input]
                        tool_args = generated_intent["tools"][0]["arguments"]
                        command = tool_args.get("command", "")
                        description = tool_args.get("explanation", "")    
                        permission = generated_intent.get("permission", "ask")
                        response = generated_intent.get("output", "")
                    except (KeyError, IndexError, TypeError):
                        print(f"{RED}TERMy Exception: LLM generated invalid entry.{RESET}")
                        return 1

                    if not command or not command.strip():
                        print(f"{RED}Generated command is empty. Nothing to execute.{RESET}")
                        return 1
                    
                    tui.render_action(
                        thinking=thinking,
                        response=Markdown(response) if response else "",
                        command=command,
                        description=description,
                        emoji=emoji,
                        title="New dataset entry"
                    )
                    
                    dataset_dir = CURRENT_BOT_DIR / "dataset"
                    dataset_dir.mkdir(parents=True, exist_ok=True)           
                    save_filename = f"dataset_{os.environ.get('USER', 'user')}.json"
                    
                    if not permission_execute() and not args.generate:
                        save_intent = tui.confirm("Do you want to save this entry in the dataset?")
                        if save_intent:
                            storage.save_entry(generated_intent, str(dataset_dir), save_filename)
                            print(f"{GREEN}Entry saved to dataset.{RESET}")
                    else:
                        storage.save_entry(
                            generated_intent, 
                            str(dataset_dir), 
                            save_filename
                        )
                        print(
                            f"{GREEN}Entry saved to dataset (due to -y flag).{RESET}"
                        )
                else:
                    print(f"{RED}TERMy failed to obtain a valid script from {llm_model}.{RESET}")
                    return 1
            except ImportError as e:
                print(f"{RED}TERMy ImportError: {e}{RESET}")
                return 1
            except Exception as e:
                print(f"{RED}TERMy Exception: {e}{RESET}")
                return 1

    if command and command.strip():
        scripts_dir = CURRENT_BOT_DIR / "scripts"
        sources = []
        if scripts_dir.is_dir():
            for file in sorted(scripts_dir.iterdir()):
                if file.suffix == ".sh":
                    sources.append(f"source {shlex.quote(str(file))}")
        if sources: command = f"{' && '.join(sources)} && {command}"
        
        if args.generate or (permission_execute() or tui.confirm("Should I run it?")):
            try:
                if not permission_execute(): print("\n")
                res = subprocess.run(
                    command, 
                    shell=True, 
                    executable="/bin/bash",
                    check=False
                )
                if not permission_execute(): print()
                return res.returncode
            except KeyboardInterrupt:
                print(f"\n{YELLOW}Execution interrupted by user.{RESET}\n")
                return 130
            except Exception as exc:
                print(f"{RED}Failed to execute command: {exc}{RESET}\n")
                return 1
        else:
            print(f"\n\n{YELLOW}Execution aborted by user.{RESET}\n")
            return 0
                
    return 0

if __name__ == "__main__":
    sys.exit(run_cli())