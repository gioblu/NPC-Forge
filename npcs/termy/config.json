{
  "name": "TERMy-24k",
  "tts": "espeak-ng",
  "creator": "Giovanni Blu Mitolo",
  "threshold": 0.6668,
  "synonym_contribution": 0.825,
  "suggestions": 10,
  "llm": {
    "provider": "ollama",
    "num_ctx": 65536,
    "enabled": true,
    "api_url": "http://localhost:11434/api/chat",
    "model": "gemma4-e4b-64k:latest"
  },
  "agent": {
    "type": "self-reflecting",
    "tools": [
      "finish",
      "tts",
      "write_file",
      "delete_file",
      "run_command"
    ]
  },
  "commands": {
    "py": {
      "head": "TMP_FILE=$(mktemp /tmp/termy_script_XXXXXX.py) && DELIM=\"__TERMY_BOUNDARY_$$_$RANDOM__\" && cat << \"$DELIM\" > \"$TMP_FILE\"\n\n",
      "tail": "\n\n$DELIM\ntermy_set_context 'active_file' \"$TMP_FILE\" && termy_set_context 'active_content' \"$(cat \"$TMP_FILE\")\""
    }
  },
  "active_datasets": []
}